# Keep all Arture configuration separate from other projects.
# Database name must begin with "arture_". The app refuses other names.
ARTURE_MONGODB_URI=mongodb+srv://ARTURE_USERNAME:ARTURE_PASSWORD@ARTURE_CLUSTER/arture_demo_dev?retryWrites=true&w=majority
ARTURE_MONGODB_DB=arture_demo_dev
ARTURE_APP_URL=http://localhost:3100
ARTURE_AUTH_SECRET=replace-with-a-new-arture-only-secret
ARTURE_UPLOAD_MAX_BYTES=2097152
ARTURE_DEMO_MODE=true
# Required only when running `npm run db:seed`; never commit real values.
ARTURE_SEED_ADMIN_EMAIL=admin@arture.demo
ARTURE_SEED_ADMIN_PASSWORD=replace-with-12-or-more-characters
ARTURE_SEED_ADMIN_NAME=Arture Admin
# Required only when running `npm run db:seed:sample`; false makes script exit before connecting.
ARTURE_SEED_SAMPLE_DATA=false
