# Keep all Arture configuration separate from other projects.
# Database name must begin with "arture_". The app refuses other names.
ARTURE_MONGODB_URI=mongodb+srv://ARTURE_USERNAME:ARTURE_PASSWORD@ARTURE_CLUSTER/arture_demo_dev?retryWrites=true&w=majority
ARTURE_MONGODB_DB=arture_demo_dev
# Set true only when intentionally sharing an existing database; all collections remain arture_-prefixed.
ARTURE_ALLOW_SHARED_DATABASE=false
ARTURE_APP_URL=http://localhost:3100
ARTURE_AUTH_SECRET=replace-with-a-new-arture-only-secret
ARTURE_UPLOAD_MAX_BYTES=2097152
ARTURE_DEMO_MODE=true
# Optional: protects public phone lookup and work-event ingestion with one shared header value.
# Clients send this in x-arture-ingest-key. Leave absent only for a local hackathon demo.
ARTURE_INGEST_KEY=replace-with-an-arture-only-ingest-key
# Required only when running `npm run db:seed`; never commit real values.
ARTURE_SEED_ADMIN_EMAIL=admin@arture.demo
ARTURE_SEED_ADMIN_PASSWORD=replace-with-12-or-more-characters
ARTURE_SEED_ADMIN_NAME=Arture Admin
# Required only when running `npm run db:seed:sample`; false makes script exit before connecting.
ARTURE_SEED_SAMPLE_DATA=false

# Phase 2 voice relay. Provider credentials stay on the server.
ARTURE_OPENAI_API_KEY=
ARTURE_GUEST_LOGIN_ENABLED=false
ARTURE_REALTIME_MODEL=gpt-realtime-2.1-mini
ARTURE_RELAY_ACCESS_KEY=replace-with-a-random-app-credential-at-least-24-characters
ARTURE_RELAY_PORT=3101
ARTURE_RELAY_ENABLED=true
# Override both URLs with the deployed wss:// endpoint when hosting remotely.
ARTURE_RELAY_URL=ws://127.0.0.1:3101/realtime
# Optional device URL; configure-unity otherwise detects a private LAN address.
# ARTURE_RELAY_DEVICE_URL=ws://YOUR_PC_LAN_ADDRESS:3101/realtime

# Optional worker directory match for Unity sessions (never sent to OpenAI).
# ARTURE_WORKER_PHONE=+91 90000 00001

# Phase 4 document search: vector uses OpenAI embeddings and Atlas by default.
ARTURE_KNOWLEDGE_MODE=vector
ARTURE_KNOWLEDGE_VECTOR_BACKEND=atlas
# start:local selects local vector scoring automatically; keyword mode needs no API key.
