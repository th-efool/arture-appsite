{
  "name": "arture-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/conversations.test.ts tests/knowledge.test.ts tests/realtime-knowledge.test.ts tests/realtime-relay.test.ts tests/water-pump.test.ts",
    "validate:env": "node --env-file=.env.local --import tsx scripts/validate-env.ts",
    "db:indexes": "node --env-file=.env.local --import tsx scripts/db-indexes.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/db-seed.ts",
    "db:seed:sample": "node --env-file=.env.local --import tsx scripts/db-seed-sample.ts",
    "db:migrate:water-pump": "node --env-file=.env.local --import tsx scripts/db-migrate-water-pump.ts",
    "test:integration": "tsx --test tests/water-pump.test.ts",
    "start:local": "tsx scripts/local-workspace.ts",
    "dev:local": "tsx scripts/local-workspace.ts --dev",
    "relay": "node --env-file=.env.local --import tsx scripts/realtime-relay.ts",
    "relay:service": "node --import tsx scripts/relay-service.ts",
    "test:relay": "tsx --test tests/realtime-relay.test.ts",
    "relay:check": "node --env-file=.env.local --import tsx scripts/check-voice-relay.ts",
    "relay:configure-unity": "node --env-file=.env.local --import tsx scripts/configure-unity-relay.ts",
    "test:conversations": "tsx --test tests/conversations.test.ts",
    "knowledge:worker": "node --env-file=.env.local --import tsx scripts/knowledge-worker.ts",
    "test:knowledge": "tsx --test tests/knowledge.test.ts",
    "test:voice-knowledge": "tsx --test tests/realtime-knowledge.test.ts",
    "relay:check:knowledge": "node --env-file=.env.local --import tsx scripts/check-grounded-voice.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.6.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "mongodb": "^7.7.0",
    "next": "^15.5.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
